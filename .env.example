# ---- The website the bot speaks for ----
SITE_NAME=Oakline Office
# A folder of .html files, or the address of a live site to crawl (https://www.example.com).
# Empty = the demo website in demo_site/.
SITE_SOURCE=
# Other websites allowed to embed the widget, comma separated (https://www.example.com).
# Empty = only pages served by this service itself.
ALLOWED_ORIGINS=

# ---- Answer writer ----
# mock = offline, no key needed. openai = any OpenAI-compatible API.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. For a local Ollama model: http://localhost:11434/v1
OPENAI_BASE_URL=
MAX_OUTPUT_TOKENS=220
# 1 = the model's own [[SALES]] / [[HUMAN]] tags may show the contact form too. Off by default:
# measure it on your model first (python -m evals.run --provider openai). The lead rules always run.
MODEL_LEAD_TAGS=

# ---- Search ----
# fastembed = real embedding model on CPU (downloads about 70 MB once). hash = offline stand-in.
EMBEDDER=fastembed
# hybrid = keywords + meaning (default). dense = meaning only. bm25 = keywords only.
SEARCH_MODE=hybrid
# Refuse when the best passage similarity is under this value. Empty = the measured default.
MIN_RELEVANCE=

# ---- Protection of your API bill ----
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_CHARS=500
DAILY_MESSAGE_BUDGET=2000
# Set to 1 behind nginx or a load balancer, so the visitor's address is read from X-Forwarded-For.
TRUST_PROXY=

# ---- Leads ----
# Where each new lead is posted (your CRM, Zapier, Make, n8n). Empty = stored only.
LEAD_WEBHOOK_URL=
# Shared secret used to sign the webhook, so the receiver can check it came from this service.
LEAD_WEBHOOK_SECRET=
# Token for the /admin page. Empty = a random one is printed when the service starts.
ADMIN_TOKEN=

PORT=8022
